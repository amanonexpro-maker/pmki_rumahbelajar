# ========================================================
# PLATFORM PELAYANAN TERPADU PMKI - ENVIRONMENT VARIABLES
# ========================================================

# Application Host & Port
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# AI Studio / Gemini API Key (Server-Side)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# PostgreSQL connection settings
SQL_HOST="localhost"
SQL_PORT=5432
SQL_DB_NAME="pmki_terpadu"
API_HOST="127.0.0.1"
API_PORT=3001

# PostgreSQL Compose credentials (set strong local passwords before starting)
SQL_ADMIN_USER="pmki_admin"
SQL_ADMIN_PASSWORD=

# Optional pgAdmin credentials (used by the dev Compose profile)
PGADMIN_DEFAULT_EMAIL="admin@pmki.org"
PGADMIN_DEFAULT_PASSWORD=

# Authentication (Auth.js / JWT Session)
AUTH_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_KEY_32_CHAR"
AUTH_URL="http://localhost:3000"

# Pilot Service Unit Configuration
PILOT_ORGANIZATION="PMKI_MUPEL_JATIM"
PILOT_SERVICE_UNIT="RB_GRIYA_ASIH_LAWANG"
