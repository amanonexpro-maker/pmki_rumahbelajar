# ==============================================================================
# PMKI PLATFORM — ENVIRONMENT VARIABLES (ADR-13 / Appendix A)
# ==============================================================================

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Public Credentials (Client & Server)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="REPLACE_WITH_LOCAL_SUPABASE_ANON_KEY"

# Supabase Privileged Credentials (SERVER ONLY — NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_LOCAL_SUPABASE_SERVICE_ROLE_KEY"

# Database Connections (PostgreSQL 17 via Supabase)
# Runtime: transaction pooler (6543 in prod, 54322 in local Supabase CLI) with prepare: false
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Migrations: session pooler (5432 in prod, 54322 in local Supabase CLI)
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase Private Storage
SUPABASE_STORAGE_BUCKET="media"
# TTL in seconds — MUST be greater than page cache/revalidate TTL (D-23/D-29)
MEDIA_SIGNED_URL_TTL="3600"

